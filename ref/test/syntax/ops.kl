def f : i64 ->{IO} i64 = \x. out(x); x

def kind : u8 -> i64 =
  \c. case c of { '(' -> 1 | ')' -> 2 | 48 -> 3 | _ -> 0 }

def sign : i64 ->{Panic} i64 = \n. case n of { -1 -> 10 | 0 -> 20 | m -> m * 2 }

main =
  out(if 1 < 2 && 3 > 2 then 1 else 0);
  out(if 1 > 2 || 2 >= 3 || 4 <= 3 || 5 != 5 then 1 else 0);
  out(if f 1 > f 2 then 7 else 8);
  out(if f 3 <= f 4 && not false then 9 else 10);
  out(kind '(' + kind ')' * 10 + kind '0' * 100 + kind 'x');
  sign (-1) + sign 0 + sign 21
