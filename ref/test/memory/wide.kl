-- 64-bit integers where they take two words (a register pair on RV32; the suite runs every
-- case there too): arithmetic across 2³², overflow in every mode, multiplication, division and
-- remainder by sign, shifts by constants and variables, comparisons on the high half, i64 and
-- u64 in data, pairs, closures and arrays, and conversions to and from narrow types.

import std.array

data Acct = Acct(u8, i64, u64)

def big : i64 = 4294967296

def shifts : i64 -> i64 ->{Panic, Diverge} i64 =
  \n acc. if n == 64 then acc else shifts (n + 1) (acc +% (0x1234_5678_9abc_def0 lsl n) +% (-7 lsr n) +% (((-8 as u64) lsr (n as u64)) as i64))

def fill : i64 -> Array i64 ->{Panic, Diverge} Array i64 =
  \i xs. if i == 40 then xs else fill (i + 1) (array.push xs (i * big - 3))

def total : Array i64 -> i64 -> i64 ->{Panic, Diverge} i64 =
  \xs i acc. if i == array.length xs then acc else total xs (i + 1) (acc + array.get xs i)

def opt : Option i64 -> i64 = \o. case o of { None -> -1 | Some(x) -> x }

def balance : Acct ->{Panic} i64 = \a. case a of { Acct(k, b, u) -> (k as i64) + b + (u as i64) }

main =
  let x = big - 1 in
  let addsub = (x + 1) * 3 - (x + 2) in
  out addsub;
  out ((0 - big) * 1000003 + 5);
  out (9223372036854775807 +| 1); out (-9223372036854775807 -| 5); out (big *| big);
  out (opt (9223372036854775800 +? 7)); out (opt (9223372036854775800 +? 8)); out (opt (big *? 5));
  out ((-100000000007) / 13); out ((-100000000007) % 13); out (100000000007 / (-13)); out (100000000007 % (-13));
  out (((-1 as u64) / (7 as u64)) as i64);
  out (shifts 0 0);
  out (if (0 - big) < 1 then 1 else 0); out (if big < big + 1 then 1 else 0); out (if (big as u64) < (1 as u64) then 1 else 0);
  let xs = array.set (fill 0 array.empty) 7 (-1) in
  let ys = array.push xs 9223372036854775000 in
  out (total xs 0 0); out (array.get ys 40); out (array.length (array.make 5 big));
  let add = \y. y + x in
  out (add 10);
  let p = (big * 3, (-5, big + 7)) in
  let (a, rest) = p in
  let (b, c) = rest in
  out (a + b + c);
  out ((x as i32) as i64); out ((big + 4000000000) as u32 as i64); out ((-3 as i8) as i64);
  balance (Acct(200 as u8, -6000000000, -446744073709551616 as u64))
