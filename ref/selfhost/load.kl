-- Load a Keel program as keelc does (Keel.Modules): the entry file, the modules it imports,
-- transitively, and the prelude, with every name made program-wide. check.kl and core.kl
-- start here.

import std.string
import std.file
import lexer
import parser
import checker

data Result a e = Ok(a) | Err(e)

def any : forall (a : Free) 'e. (a ->{'e} Bool) -> List a ->{'e} Bool =
  \f xs. case xs of { Nil -> false | Cons(x, rest) -> if f x then true else any f (unbox rest) }

-- The path before the first newline.
def firstLine : List u8 -> List u8 =
  \s. case s of { Nil -> Nil | Cons(c, rest) -> if c == '\n' then Nil else Cons(c, box (firstLine (unbox rest))) }

-- Everything up to and including the last '/', or "" (the directory imports resolve against).
def dirOf : List u8 -> List u8 =
  \p. reverse (dropToSlash (reverse p))

def dropToSlash : List u8 -> List u8 =
  \s. case s of { Nil -> Nil | Cons(c, rest) -> if c == '/' then Cons(c, rest) else dropToSlash (unbox rest) }

-- The file of an import, as Keel.Modules.importPath: `a.b` is ROOT/a/b.kl, `std.m` is
-- std/m.kl (relative to ref/, where keelc's std lives).
def importPath : List u8 -> List u8 ->{Diverge} List u8 =
  \root imp. case imp of
    { Cons(s, Cons(t, Cons(d, Cons(dot, m)))) ->
        if s == 's' && t == 't' && d == 'd' && dot == '.' then append "std/" (file (unbox m)) else append root (file imp)
    | _ -> append root (file imp) }

def file : List u8 ->{Diverge} List u8 =
  \m. append (map (\c. if c == '.' then '/' else c) m) ".kl"

-- Parse a file: its module, or an error line.
def load : List u8 ->{Files, Diverge, Panic} Result Module (List u8) =
  \path. case file.read path of
    { None -> Err(append "missing " path)
    | Some(text) ->
        let (m, ts) = parser.parse (lexer.lex text 1 1) in
        case parser.tok ts of { Error(msg) -> Err(append path (append ": " msg)) | _ -> Ok(m) } }

-- Every module the entry imports, transitively, then the entry, each loaded once and after
-- the modules it imports (Keel.Modules.visit): (module name, module).
def visit : List u8 -> List (List u8) -> List u8 -> List u8 -> List (List u8, (List u8, Module)) ->{Files, Diverge, Panic} Result (List (List u8, (List u8, Module))) (List u8) =
  \root stack name path done.
    if checker.elem name stack then Err(append "import cycle at " name)
    else if any (\d. let (n, pm) = d in string.equal n name) done then Ok(done)
    else case load path of
      { Err(e) -> Err(e)
      | Ok(m) -> case m of
          { Module(imps, ds, entry) -> case visitAll root (Cons(name, box stack)) imps done of
              { Err(e) -> Err(e)
              | Ok(done) -> Ok(append done (Cons((name, (path, Module(imps, ds, entry))), box Nil))) } } }

def visitAll : List u8 -> List (List u8) -> List (List u8, List u8) -> List (List u8, (List u8, Module)) ->{Files, Diverge, Panic} Result (List (List u8, (List u8, Module))) (List u8) =
  \root stack imps done. case imps of
    { Nil -> Ok(done)
    | Cons(iq, rest) -> let (imp, q) = iq in
        case visit root stack imp (importPath root imp) done of
          { Err(e) -> Err(e)
          | Ok(done) -> visitAll root stack (unbox rest) done } }

-- Program-wide names, as Keel.Modules: a module sees its own declarations, its imports' public
-- ones (plain or qualified) and the prelude. A private name, a name several modules declare,
-- and another module's name the prelude also has become name@module.
-- ponytail: the errors (ambiguous, private, unknown names) aren't ported: keelc reports them
-- while loading, and the test skips files that don't load. Such a name stays as written.
--
-- Scope(public names by module, private names by module, the prelude's names, entry module).
data Scope = Scope(List (List u8, List (List u8)), List (List u8, List (List u8)), List (List u8), List u8)

-- A module's resolver: Res(scope, module, its own names → internal, qualifier → module, imports,
-- its file, for the positions in its terms).
data Res = Res(Scope, List u8, List (List u8, List u8), List (List u8, List u8), List (List u8), List u8)

def lookupS : List u8 -> List (List u8, List u8) ->{Diverge} Option (List u8) =
  \k kvs. case kvs of
    { Nil -> None
    | Cons(kv, rest) -> let (k2, v) = kv in if string.equal k k2 then Some(v) else lookupS k (unbox rest) }

def namesOf : List u8 -> List (List u8, List (List u8)) ->{Diverge} List (List u8) =
  \m ns. checker.concatMap (\mn. let (n, xs) = mn in if string.equal n m then xs else Nil) ns

def several : List (List u8) -> Bool =
  \xs. case xs of { Cons(x, rest) -> not (checker.isNil (unbox rest)) | Nil -> false }

def internal : Scope -> List u8 -> Bool -> List u8 ->{Diverge} List u8 =
  \sc m priv n. case sc of
    { Scope(pubs, privs, pre, entry) ->
        let owners = checker.concatMap (\mn. let (k, xs) = mn in if checker.elem n xs then Cons(k, box Nil) else Nil) pubs in
        if priv || several owners || (not (string.equal m entry) && checker.elem n pre) then append n (Cons('@', box m)) else n }

def plain : Res -> List u8 ->{Diverge} List u8 =
  \r n. case r of
    { Res(sc, self, own, quals, imported, file) -> case lookupS n own of
        { Some(i) -> i
        | None -> case sc of
            { Scope(pubs, privs, pre, entry) ->
                case checker.filterL (\m. checker.elem n (namesOf m pubs)) imported of
                  { Cons(m, more) -> if checker.isNil (unbox more) && not (checker.elem n pre) then internal sc m false n else n
                  | Nil -> n } } } }

-- A name as written, maybe qualified: q.f, q.Type, q.Con, prelude.f.
def name : Res -> List u8 ->{Diverge} List u8 =
  \r n. case r of
    { Res(sc, self, own, quals, imported, file) ->
        let q = takeTo '.' n in let f = dropTo '.' n in
        if checker.isNil f then plain r n
        else case lookupS q quals of
          { Some(m) -> internal sc m false f
          | None -> if string.equal q "prelude" then f else plain r n } }

def takeTo : u8 -> List u8 -> List u8 =
  \c s. case s of { Nil -> Nil | Cons(x, rest) -> if x == c then Nil else Cons(x, box (takeTo c (unbox rest))) }

def dropTo : u8 -> List u8 -> List u8 =
  \c s. case s of { Nil -> Nil | Cons(x, rest) -> if x == c then unbox rest else dropTo c (unbox rest) }

def ty : Res -> Ty ->{Diverge} Ty =
  \r t. case t of
    { TData(n, args) -> TData(name r n, box (map (\a. ty r a) (unbox args)))
    | TFun(a, e, b) -> TFun(box (ty r (unbox a)), effs r e, box (ty r (unbox b)))
    | TLFun(a, e, b) -> TLFun(box (ty r (unbox a)), effs r e, box (ty r (unbox b)))
    | TBox(a) -> TBox(box (ty r (unbox a)))
    | TPair(a, b) -> TPair(box (ty r (unbox a)), box (ty r (unbox b)))
    | TRef(a) -> TRef(box (ty r (unbox a)))
    | TMut(a) -> TMut(box (ty r (unbox a)))
    | TForall(vs, es, b) -> TForall(vs, es, box (ty r (unbox b)))
    | _ -> t }

def effs : Res -> List (List u8) ->{Diverge} List (List u8) =
  \r e. checker.sFrom (map (\l. case l of { Cons(c, rest) -> if c == '\'' then Cons(c, rest) else name r (Cons(c, rest)) | Nil -> Nil }) e)

def has : List u8 -> List (List u8, List u8) ->{Diverge} Bool =
  \k kvs. case lookupS k kvs of { Some(v) -> true | None -> false }

-- Global names in a term; local variables (bound) may shadow them.
def term : Res -> List (List u8) -> Term ->{Diverge} Term =
  \r bound tm. case tm of
    { EVar(x) -> if checker.elem x bound then EVar(x) else EVar(plain r x)
    | EProj(e, o) -> (case unbox e of
        { EVar(q) -> (case r of
            { Res(sc, self, own, quals, imported, file) ->
                if not (checker.elem q bound) && (has q quals || string.equal q "prelude") then EVar(name r (append q (Cons('.', box o))))
                else EProj(box (EVar(q)), o) })
        | e2 -> EProj(box (term r bound e2), o) })
    | EAt(f, l, c, b) -> (case r of { Res(sc, self, own, quals, imported, file) -> EAt(file, l, c, box (term r bound (unbox b))) })
    | ELam(x, t, b) -> ELam(x, ty r t, box (term r (Cons(x, box bound)) (unbox b)))
    | EApp(f, a) -> EApp(box (term r bound (unbox f)), box (term r bound (unbox a)))
    | ELet(x, e, b) -> ELet(x, box (term r bound (unbox e)), box (term r (Cons(x, box bound)) (unbox b)))
    | ELetPair(x, y, e, b) -> ELetPair(x, y, box (term r bound (unbox e)), box (term r (Cons(x, box (Cons(y, box bound)))) (unbox b)))
    | EVarIn(x, e, b) -> EVarIn(x, box (term r bound (unbox e)), box (term r (Cons(x, box bound)) (unbox b)))
    | EAssign(x, e) -> EAssign(x, box (term r bound (unbox e)))
    | ESeq(a, b) -> ESeq(box (term r bound (unbox a)), box (term r bound (unbox b)))
    | EIf(c, a, b) -> EIf(box (term r bound (unbox c)), box (term r bound (unbox a)), box (term r bound (unbox b)))
    | EPrim(op, a, b) -> EPrim(op, box (term r bound (unbox a)), box (term r bound (unbox b)))
    | EConvert(to, e) -> EConvert(to, box (term r bound (unbox e)))
    | EBox(e) -> EBox(box (term r bound (unbox e)))
    | EUnbox(e) -> EUnbox(box (term r bound (unbox e)))
    | EPair(a, b) -> EPair(box (term r bound (unbox a)), box (term r bound (unbox b)))
    | ECon(c, tys, args) -> ECon(name r c, box (map (\t. ty r t) (unbox tys)), box (map (\a. term r bound a) (unbox args)))
    | ECase(e, alts) -> ECase(box (term r bound (unbox e)),
        box (map (\al. case al of { Alt(c, xs, b) -> Alt(if string.equal c "_" then c else name r c, xs, term r (append xs bound) b) }) (unbox alts)))
    | EHandle(l, e, cs) -> EHandle(name r l, box (term r bound (unbox e)),
        box (map (\al. case al of { Alt(op, xs, b) -> Alt(plain r op, xs, term r (append xs bound) b) }) (unbox cs)))
    | ECocase(d, tys, bs) -> ECocase(name r d, box (map (\t. ty r t) (unbox tys)),
        box (map (\al. case al of { Alt(o, xs, b) -> Alt(o, xs, term r bound b) }) (unbox bs)))
    | ETyApp(f, tys) -> ETyApp(name r f, box (map (\t. ty r t) (unbox tys)))
    | EBits(b, fs) -> EBits(name r b, box (map (\al. case al of { Alt(f, xs, e) -> Alt(f, xs, term r bound e) }) (unbox fs)))
    | _ -> tm }

def ctors : Res -> Bool -> List Ctor ->{Diverge} List Ctor =
  \r rename cs. map (\c. case c of { Ctor(n, ts) -> Ctor(if rename then plain r n else n, map (\t. ty r t) ts) }) cs

def decl : Res -> Decl ->{Diverge} Decl =
  \r d. case d of
    { DData(lin, n, ps, cs) -> DData(lin, plain r n, ps, ctors r true cs)
    | DCodata(n, ps, os) -> DCodata(plain r n, ps, ctors r false os)
    | DEffect(l, ops) -> DEffect(plain r l, ctors r true ops)
    | DDef(f, t, e) -> DDef(plain r f, ty r t, term r Nil e)
    | DBitdata(n, it, fs) -> DBitdata(plain r n, it, fs)
    | DCell(n, it, isArr, len, v) -> DCell(plain r n, it, isArr, len, v)
    | DQueue(n, dn, len) -> DQueue(plain r n, name r dn, len) }

-- A module's declarations and main, under program-wide names.
def resolve : Scope -> (List u8, (List u8, Module)) ->{Diverge} (List Decl, Option Term) =
  \sc nm. let (self, pm) = nm in let (path, m) = pm in case m of
    { Module(imps, ds, entry) ->
        let own = checker.concatMap (\pd. let (p, d) = pd in map (\n. (n, internal sc self p n)) (checker.declared d)) ds in
        let r = Res(sc, self, own, map (\iq. let (i, q) = iq in (q, i)) imps, map (\iq. let (i, q) = iq in i) imps, path) in
        (map (\pd. let (p, d) = pd in decl r d) ds, case entry of { Some(e) -> Some(term r Nil e) | None -> None }) }

def namesBy : Bool -> List (List u8, (List u8, Module)) ->{Diverge} List (List u8, List (List u8)) =
  \priv ms. map (\nm. let (n, pm) = nm in let (path, m) = pm in case m of
    { Module(imps, ds, entry) -> (n, checker.sFrom (checker.concatMap (\pd. let (p, d) = pd in if p == priv then checker.declared d else Nil) ds)) }) ms

-- The file name without directory and .kl: the entry module's name.
def baseName : List u8 ->{Diverge} List u8 =
  \p. reverse (dropN 3 (takeTo '/' (reverse p)))

def dropN : forall (a : Free). i64 -> List a ->{Diverge} List a =
  \n xs. if n <= 0 then xs else (case xs of { Nil -> Nil | Cons(x, rest) -> dropN (n -% 1) (unbox rest) })

-- A program from its entry file: the prelude's declarations, every module's declarations
-- under program-wide names, and the entry's main; or why it couldn't be loaded.
def programOf : List u8 ->{Files, Diverge, Panic} Result (List Decl, (List (Bool, Decl), Option Term)) (List u8) =
  \path. programWith path Nil None

-- The same with declarations added to the entry module and, when given, another main (the
-- REPL's input). With no path the entry is an empty module, repl.
def programWith : List u8 -> List (Bool, Decl) -> Option Term ->{Files, Diverge, Panic} Result (List Decl, (List (Bool, Decl), Option Term)) (List u8) =
  \path extra main2. case load "selfhost/prelude.kl" of
    { Err(e) -> Err(e)
    | Ok(pre) -> case pre of
        { Module(pimps, pds, pentry) ->
            let entry = if checker.isNil path then "repl" else baseName path in
            let found = if checker.isNil path then Ok(Cons(("repl", ("repl.kl", Module(Nil, Nil, None))), box Nil)) else visit (dirOf path) Nil entry path Nil in
            case found of
            { Err(e) -> Err(e)
            | Ok(ms0) ->
                let ms = map (\nm. let (n, pm) = nm in let (fp, m) = pm in
                  if string.equal n entry then (case m of { Module(imps, ds, own) -> (n, (fp, Module(imps, append ds extra, case main2 of { Some(e) -> Some(e) | None -> own }))) })
                  else nm) ms0 in
                let lib = map (\pd. let (priv, d) = pd in d) pds in
                let sc = Scope(namesBy false ms, namesBy true ms, checker.concatMap checker.declared lib, entry) in
                let resolved = map (\nm. resolve sc nm) ms in
                let decls = checker.concatMap (\dm. let (ds, m) = dm in map (\d. (false, d)) ds) resolved in
                let mains = checker.concatMap (\dm. let (ds, m) = dm in case m of { Some(e) -> Cons(e, box Nil) | None -> Nil }) resolved in
                Ok((lib, (decls, case mains of { Cons(e, rest) -> Some(e) | Nil -> None }))) } } }

-- Source text typed at a prompt, parsed as a module, or the parse error.
def parseText : List u8 ->{Diverge, Panic} Result Module (List u8) = \text. parseTextAt text 1

-- The same, with the first character at this column (a prefix the user didn't type can
-- start left of column 1).
def parseTextAt : List u8 -> i64 ->{Diverge, Panic} Result Module (List u8) =
  \text col. let (m, ts) = parser.parse (lexer.lex text 1 col) in
    case parser.tok ts of { Error(msg) -> Err(msg) | _ -> Ok(m) }
