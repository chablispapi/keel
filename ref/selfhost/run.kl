-- Run a Keel program as `keelc run` does, with the self-hosted front end and evaluator: its
-- output, then `result: <value>` or `panic: <message>`, then each file it wrote as a
-- `file <path> <length>` line, its bytes and a newline. stdin is the entry file's path on the
-- first line, then the program's own stdin:
--
--   printf 'examples/fact.kl\n' | keelc run selfhost/run.kl
--
-- Files and the network are mocked as Eval.hs's machine does: the program can read the files
-- of the test suite's machineFor, writes stay in memory, and sockets connect in a loopback.

import std.string
import std.file
import load
import checker
import eval

-- The first line of stdin, read byte by byte so the rest stays for the program.
def readLine : List u8 ->{Input, Diverge} List u8 =
  \acc. let c = getc () in if c < 0 || c == 10 then reverse acc else readLine (Cons(c as u8, box acc))

-- The files a program may read (ref/test/Native.hs's machineFor).
def disk : Unit ->{Files, Diverge} List (List u8, List u8) =
  \u. case file.read "examples/fact.kl" of { Some(t) -> Cons(("examples/fact.kl", t), box Nil) | None -> Nil }

def printFiles : List (List u8, List u8) ->{IO, Diverge, Panic} Unit =
  \fs. case fs of
    { Nil -> ()
    | Cons(pt, rest) -> let (path, text) = pt in
        print "file "; print path; putc(' '); printInt (length text); putc('\n'); print text; putc('\n');
        printFiles (unbox rest) }

main =
  case programOf (readLine Nil) of
    { Err(e) -> println e; -1
    | Ok(p) -> let (lib, rest) = p in let (decls, entry) = rest in
        case entry of
          { None -> println "unsupported: no main"; 0
          | Some(prog) -> case checker.program lib decls prog of
              { Rejected(msg) -> println msg; -1
              | Core(ds, m, t, eff) -> case runMain (disk ()) ds m of
                  { Val(v, w) -> print "result: "; println (show v); printFiles (writtenFiles w); 0
                  | Bad(msg, w) -> print "panic: "; println msg; printFiles (writtenFiles w); 0 } } } }
