-- Type-check a Keel program and print keelc check's verdict line: `ok: main : T ! {E…}`,
-- `file:line:col: error [Kind]: message` (no position when keelc gives none), or
-- `unsupported: <feature>` for what the checker doesn't handle yet.
-- stdin holds the entry file's path (stdin has no name, and imports resolve against it):
--
--   echo examples/fact.kl | keelc run selfhost/check.kl
--
-- The result is 0 for a verdict, -1 when a file is missing or doesn't parse.

import load
import checker

main =
  case programOf (firstLine (readAll ())) of
    { Err(e) -> println e; -1
    | Ok(p) -> let (lib, rest) = p in let (decls, entry) = rest in println (checker.verdict lib decls entry); 0 }
