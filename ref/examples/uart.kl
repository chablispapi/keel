-- A UART driver for the 16550 on QEMU's RISC-V virt board, written against the built-in
-- MMIO effect and tested here against a mock device. firmware/hello.kl runs the same driver
-- on the real (emulated) hardware.
--
-- Registers: 0x1000_0000 sends a byte; bit 5 of the line status register (offset 5) says the
-- transmitter can take another one.

data List a = Nil | Cons(a, Box (List a))

bitdata LineStatus : u8 { thr_empty @ 5 }

def putc : u8 ->{MMIO, Diverge} Unit =
  \c. if LineStatus(read8(0x1000_0005)).thr_empty == 1 then write8(0x1000_0000, c)
      else putc c

def send : List u8 ->{MMIO, Diverge} Unit =
  \xs. case xs of
    { Nil -> ()
    | Cons(c, rest) -> putc c; send (unbox rest) }

-- The mock: the transmitter is always ready, and every byte sent is printed.
main =
  handle send (Cons(72, box Cons(105, box Nil))) with MMIO
    { read8 addr -> LineStatus { thr_empty = 1 }.raw
    | read32 addr -> 0
    | write8 w -> let (reg, byte) = w in out(byte as i64)
    | write32 w -> () }
