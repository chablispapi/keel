-- Sorting with an explicit dictionary: Ord is codata, an ordering is a cocase value,
-- and sort takes it as an ordinary argument (no type classes).

data List a = Nil | Cons(a, Box (List a))

codata Ord a { lt : a -> a -> Bool }

def insert : forall (a : Free). Ord a -> a -> List a ->{Diverge} List a =
  \o x xs. case xs of
    { Nil -> Cons(x, box Nil)
    | Cons(y, rest) ->
        if o.lt x y then Cons(x, box Cons(y, rest))
        else Cons(y, box (insert o x (unbox rest))) }

def sort : forall (a : Free). Ord a -> List a ->{Diverge} List a =
  \o xs. case xs of
    { Nil -> Nil
    | Cons(y, rest) -> insert o y (sort o (unbox rest)) }

def descending : Ord i64 = cocase Ord { lt -> \p q. q < p }

main = sort descending (Cons(3, box Cons(1, box Cons(2, box Nil))))
