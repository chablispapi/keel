-- Goose's bench/goose/bintrees.goose (the Benchmarks Game's binary-trees), ported: build many
-- short-lived complete binary trees, check each, drop it; one long-lived tree is kept.
-- Every node is a reference-counted heap block; each short-lived tree lives in an arena.

data Tree = Leaf | Node(Box Tree, Box Tree)

def maxDepth : i64 = 17 -- BENCH_N
def minDepth : i64 = 4

def make : i64 ->{Panic, Diverge} Tree =
  \d. if d == 0 then Leaf else Node(box (make (d - 1)), box (make (d - 1)))

-- Consumes the tree: each node is freed as soon as it has been counted.
def check : Tree ->{Panic, Diverge} i64 =
  \t. case t of { Leaf -> 1 | Node(l, r) -> 1 + check (unbox l) + check (unbox r) }

-- Build, check, discard: the arena frees the whole tree at once, as Goose's local pool does.
def treeCheck : i64 ->{Panic, Diverge} i64 = \d. arena (\u. check (make d))

def emit : i64 ->{IO, Diverge, Panic} Unit = \n. printInt n; putc('\n')

def sums : i64 -> i64 -> i64 ->{Panic, Diverge} i64 =
  \d i acc. if i == 0 then acc else sums d (i - 1) (acc + treeCheck d)

def depths : i64 ->{IO, Panic, Diverge} Unit =
  \d. if d > maxDepth then () else
      let iters = 1 lsl (maxDepth - d + minDepth) in
      emit iters; emit d; emit (sums d iters 0); depths (d + 2)

main =
  emit (treeCheck (maxDepth + 1));
  let long = make maxDepth in
  depths minDepth;
  emit (check long);
  0
