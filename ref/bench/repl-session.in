:load selfhost/lexer.kl
let sample = "def f : i64 -> i64 = \\x. x + 1"
def tokCount : List u8 ->{Diverge, Panic} i64 = \s. length (lex s 1 1)
:t tokCount
:t lex
tokCount sample
length (lex "def id : forall a. a -> a = \\x. x" 1 1)
length (lex "data Pair a b = Pair(a, b)" 1 1)
length (lex "linear data Handle = Handle(i64)" 1 1)
length (lex "codata Stream a = { head : a | tail : Stream a }" 1 1)
length (lex "effect Yield a { yield : a -> Unit }" 1 1)
length (lex "let x = 0xff_00 + 250u8 + 1_000_000 in x" 1 1)
length (lex "let y = 3.14159 + 1.0e-3 + 2.5e+2 in y" 1 1)
length (lex "let s = \"hello\\n\\t\\r\\\\\\\"\\'\\65\\x41\" in s" 1 1)
length (lex "let c = 'a' in let d = '\\n' in let e = '\\x41' in c" 1 1)
length (lex "def g : forall 'e. (i64 ->{'e} i64) -> i64 ->{'e} i64 = \\f x. f x" 1 1)
length (lex "-- line comment\n{- nested {- block -} comment -} 1 + 2" 1 1)
length (lex "case xs of { Nil -> 0 | Cons(x, r) -> 1 + length (unbox r) }" 1 1)
length (lex "handle f () with { return x -> x | yield v k -> k () }" 1 1)
length (lex "if a && b || c == d && e != f && g <= h && i >= j then 1 else 0" 1 1)
length (lex "bitdata Flags = Flags { a : 1, b : 7 }" 1 1)
length (lex "cell counter : i64 = 0" 1 1)
length (lex "0..10" 1 1)
length (lex "a land b lor c lxor d lsl 2 lsr 1" 1 1)
tokCount "def main : Unit ->{IO} Unit = \\u. println \"ok\""
case lex "let x = 42 in x" 1 1 of { Nil -> 0 | Cons(t, r) -> case t of { At(l, c, k) -> l * 100 + c } }
:q
