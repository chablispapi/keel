-- Strings are List u8 (UTF-8 bytes, as string literals are): comparing, converting to and
-- from numbers, splitting, and classifying bytes.
--
--   import std.string
--   map.insert string.compare "key" 1 m

-- Byte order, which is code point order for UTF-8.
def compare : List u8 -> List u8 -> Ordering =
  \a b. case a of
    { Nil -> case b of { Nil -> Equal | Cons(y, ys) -> Less }
    | Cons(x, xs) -> case b of
        { Nil -> Greater
        | Cons(y, ys) -> if x < y then Less else if y < x then Greater else compare (unbox xs) (unbox ys) } }

def equal : List u8 -> List u8 -> Bool =
  \a b. case compare a b of { Equal -> true | Less -> false | Greater -> false }

def isDigit : u8 -> Bool = \c. if c < 48 then false else c < 58

def isSpace : u8 -> Bool = \c. if c == 32 then true else if c < 9 then false else c < 14

def isAlpha : u8 -> Bool =
  \c. if c < 65 then false else if c < 91 then true else if c == 95 then true else if c < 97 then false else c < 123

-- Digits of n, most significant first, onto acc.
private def digitsOnto : u64 -> List u8 ->{Diverge, Panic} List u8 =
  \n acc. let d = Cons((n % 10 + 48) as u8, box acc) in if n < 10 then d else digitsOnto (n / 10) d

-- Decimal; negative numbers go through -(n + 1), which can't overflow.
def fromInt : i64 ->{Diverge, Panic} List u8 =
  \n. if n < 0 then Cons(45, box (digitsOnto (((0 - (n + 1)) as u64) + 1) Nil))
      else digitsOnto (n as u64) Nil

-- Decimal, to 17 significant digits (enough to read the same f64 back) without trailing
-- zeros: 1.5, -0.25, 100, 0.001, 1.2345e-7, 6.02214076e23, inf, nan. Plain notation from
-- 0.00001 up to 17 digits before the point, scientific otherwise.
-- ponytail: scales with one multiplication or division by an exact power of ten (a few for
-- exponents beyond ±22), so the 17th digit can be one off from C's %.17g, the same on every
-- target; port Ryu for exact shortest output.
def fromFloat : f64 ->{Diverge, Panic} List u8 =
  \x. if x != x then "nan"
      else if (floatToBits x) lsr 63 == 1 then Cons(45, box (magnitude (0.0 - x)))
      else magnitude x

private def magnitude : f64 ->{Diverge, Panic} List u8 =
  \x. if x == 0.0 then "0"
      else if x == floatFromBits 0x7ff0_0000_0000_0000 then "inf"
      else
        let (m, e) = digitsAt x (estimate x 0) in
        layout (reverse (dropZeros (reverse (digitsOnto m Nil)))) e

-- About where x's first digit is: 10^e.
private def estimate : f64 -> i64 ->{Diverge, Panic} i64 =
  \y e. if y >= 10.0 then estimate (y / 10.0) (e + 1) else if y < 1.0 then estimate (y * 10.0) (e - 1) else e

-- x's 17 significant digits as an integer, and the power of ten of the first one.
private def digitsAt : f64 -> i64 ->{Diverge, Panic} (u64, i64) =
  \x e.
    let y = scaleBy x (16 - e) in
    if y >= 1e17 then digitsAt x (e + 1) else if y < 1e16 then digitsAt x (e - 1) else (y as u64, e)

-- x·10^s; every f64 in [1e16, 1e17) is an integer.
private def scaleBy : f64 -> i64 ->{Diverge, Panic} f64 =
  \x s. if s > 22 then scaleBy (x * 1e22) (s - 22)
        else if s < -22 then scaleBy (x / 1e22) (s + 22)
        else if s >= 0 then x * pow10 s 1.0
        else x / pow10 (0 - s) 1.0

-- 10^k, exact for k ≤ 22.
private def pow10 : i64 -> f64 ->{Diverge, Panic} f64 = \k acc. if k < 1 then acc else pow10 (k - 1) (acc * 10.0)

private def dropZeros : List u8 -> List u8 =
  \s. case s of { Nil -> Nil | Cons(c, rest) -> if c == 48 then dropZeros (unbox rest) else Cons(c, rest) }

-- Digits d₁d₂… with d₁ in the 10^e place.
private def layout : List u8 -> i64 ->{Diverge, Panic} List u8 =
  \ds e.
    if e >= 17 || e < -5 then
      (case ds of
        { Nil -> Nil
        | Cons(d, rest) ->
            let r = unbox rest in
            let tail = Cons(101, box (fromInt e)) in
            case r of { Nil -> Cons(d, box tail) | _ -> Cons(d, box Cons(46, box (append r tail))) } })
    else if e < 0 then Cons(48, box Cons(46, box (zerosOnto (0 - e - 1) ds)))
    else whole ds e

-- The digits for 10^e down to 10^0 (zeros past the end), then a point and the rest, if any.
private def whole : List u8 -> i64 ->{Diverge, Panic} List u8 =
  \ds e. case ds of
    { Nil -> zerosOnto (e + 1) Nil
    | Cons(d, rest) ->
        if e == 0 then (case unbox rest of { Nil -> Cons(d, box Nil) | r -> Cons(d, box Cons(46, box r)) })
        else Cons(d, box (whole (unbox rest) (e - 1))) }

private def zerosOnto : i64 -> List u8 ->{Diverge, Panic} List u8 =
  \n acc. if n < 1 then acc else zerosOnto (n - 1) (Cons(48, box acc))

private def digitsValue : i64 -> List u8 ->{Panic} Option i64 =
  \acc s. case s of
    { Nil -> Some(acc)
    | Cons(c, rest) -> if isDigit c then digitsValue (acc * 10 + (c as i64) - 48) (unbox rest) else None }

-- A decimal number with an optional leading -, or None. Panics on overflow.
-- ponytail: -9223372036854775808 overflows (it is parsed as -(9223372036854775808)).
def parseInt : List u8 ->{Panic} Option i64 =
  \s. case s of
    { Nil -> None
    | Cons(c, rest) ->
        if c == 45 then
          (case unbox rest of
            { Nil -> None
            | Cons(d, more) -> case digitsValue 0 (Cons(d, more)) of { None -> None | Some(n) -> Some(0 - n) } })
        else digitsValue 0 (Cons(c, rest)) }

-- The pieces between separators: split 44 "a,,b" is ["a", "", "b"].
def split : u8 -> List u8 -> List (List u8) =
  \sep s. splitOnto sep s Nil

private def splitOnto : u8 -> List u8 -> List u8 -> List (List u8) =
  \sep s piece. case s of
    { Nil -> Cons(reverse piece, box Nil)
    | Cons(c, rest) ->
        if c == sep then Cons(reverse piece, box (splitOnto sep (unbox rest) Nil))
        else splitOnto sep (unbox rest) (Cons(c, box piece)) }

-- Lines without their newlines; a final newline doesn't start an empty line.
def lines : List u8 -> List (List u8) =
  \s. case reverse s of
    { Nil -> Nil
    | Cons(c, rest) -> if c == 10 then split 10 (reverse (unbox rest)) else split 10 s }

-- The pieces joined with a separator.
def join : List u8 -> List (List u8) ->{Diverge} List u8 =
  \sep parts. case parts of
    { Nil -> Nil
    | Cons(p, rest) -> case unbox rest of
        { Nil -> p
        | Cons(q, more) -> append p (append sep (join sep (Cons(q, more)))) } }
