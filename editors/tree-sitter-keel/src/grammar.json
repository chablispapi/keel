            "value": "\\{-([^-]|-+[^-}])*-+\\}"
          }
        ]
      }
    },
    "constructor": {
      "type": "PATTERN",
      "value": "[A-Z][A-Za-z0-9_]*"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z_][A-Za-z0-9_]*"
    },
    "effect_variable": {
